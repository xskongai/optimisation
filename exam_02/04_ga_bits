import random

from exercises.genetic_algorithm import fitness


# minimize
def f(bits):
    return sum(bits)


def init(n=50):
    return [random.choice([0, 1]) for _ in range(n)]


def nbr(bits, mutate_rate=0.01):
    new_bits = bits[:]
    n = len(bits)
    for i in range(n):
        if random.random() < mutate_rate:
            new_bits[i] = 1 - new_bits[i]
    return new_bits


def crossover_1point(p1, p2):
    n = len(p1)
    cut = random.randrange(n)
    child1 = p1[:cut] + p2[cut:]
    child2 = p2[:cut] + p1[cut:]
    return child1, child2


def select_tournament(pop, fitness, tournament_k=5):
    candidates = random.sample(list(zip(pop, fitness)), tournament_k)
    return min(candidates, key=lambda pair: pair[1])[0]


def ga_bits(n=20, pop_size=100, generation=200, p_crossover=0.9, p_mutate=0.01, tournament_k=5, elitism=2):
    pop = [init(n=20) for _ in range(pop_size)]
    fitness = [f(bits) for bits in pop]

    for _ in range(generation):
        elite = sorted(list(zip(pop, fitness)), key=lambda pair: pair[1])[:elitism]
        next_pop = [pop for pop, fitness in elite]

        while len(next_pop) < pop_size:
            p1, p2 = select_tournament(pop, fitness, tournament_k=5), select_tournament(pop, fitness, tournament_k=5)
            c1, c2 = crossover_1point(p1, p2)
            c1 = nbr(c1)
            c2 = nbr(c2)
            next_pop.extend([c1, c2])
        pop = next_pop[:pop_size]
        fitness = [f(bits) for bits in pop]

    best = min(list(zip(pop, fitness)), key=lambda pair: pair[1])
    return best[0], best[1]


def main():
    print("--ga,bits--")
    best_sol, best_fitness = ga_bits()
    print(f"best_sol:{best_sol}, best_fitness:{best_fitness}")

    pass


if __name__ == "__main__":
    main()
